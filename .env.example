PORT=3000

# ── Google Sheets (required to save grades) ─────────────────────────────────
# GradeScan opens and writes a teacher's sheet with THIS SERVER'S OWN Google account (a "service
# account", the robot). The teacher pastes the sheet's link and shares that one sheet with the robot's
# e-mail (Editor); GradeScan never gets access to the teacher's Google account or to their other sheets.
# One-time setup by whoever runs this server (full steps in DEPLOY.md, Part 2):
#   1. Google Cloud Console → create a project → enable "Google Sheets API"
#   2. IAM & Admin → Service Accounts → Create service account → Keys → Add key → JSON
#   3. Save the downloaded file as backend/service-account.json (a secret: never e-mail it,
#      paste it in a chat or upload it to GitHub). The app shows its e-mail under Settings → TEST.
# Option B: path or inline JSON instead of the file
# GOOGLE_SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── "Continue with Google" (identifies the teacher; also lets attendance mode create its own sheets) ──
# The app's sign-in page asks Google for the name and e-mail (scopes openid, email, profile) and, on the same
# page, for the non-sensitive per-file scope drive.file: it reaches only the files GradeScan itself creates in
# the teacher's Drive (the attendance sheets), never the rest of their Drive, and the teacher may untick it.
# No Sheets permission is requested: teacher sheets are opened by the server's own Google account (above),
# and only the ones their owner shared with it. One-time setup (DEPLOY.md, Part 3):
#   1. Google Cloud Console → OAuth consent screen / Google Auth Platform (External) → Data Access:
#      openid, userinfo.email, userinfo.profile and drive.file; add your teachers as Test users
#   2. Credentials → Create credentials → OAuth client ID → type "Web application" →
#      Authorized redirect URI: see the two modes below
#   3. Paste the client ID and secret here
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Google only accepts an https address (or http://localhost) for "where to send the browser back",
# so a PC on Wi-Fi (http://192.168.1.5:3000) cannot be that address. Two ways:
#
# A) Server on your PC  →  put the free static page auth-relay/callback.html on GitHub Pages and
#    use its address here AND as the Authorized redirect URI in Google Cloud (copy it exactly):
# GOOGLE_REDIRECT_URI=https://your-github-name.github.io/gradescan-auth/callback.html
#
# B) Server on a host with its own https address (Render, Cloud Run, ...)  →  leave
#    GOOGLE_REDIRECT_URI empty, set PUBLIC_URL and register <PUBLIC_URL>/auth/google/callback
#    in Google Cloud (the server prints the exact address at startup). On Render, its own RENDER_EXTERNAL_URL is used when PUBLIC_URL is empty.
# PUBLIC_URL=https://gradescan-api.onrender.com
#
# Only needed if you change "scheme" in the mobile app.json (default: gradescan). Expo Go works as is.
# (With A), also add the new scheme to APP_SCHEMES inside callback.html.)
# APP_SCHEME=gradescan

# ── OCR (student names + grades from photographed sheets) ───────────────────
# Handwritten Arabic names are read by Google Gemini (far more accurate than Tesseract:
# character error rate ~0.13 vs ~0.54 on the KITAB-Bench Arabic OCR benchmark).
#
# 1. Get a free key (no billing needed): https://aistudio.google.com/apikey
# 2. Paste it below.
#
# PRIVACY: on Google's FREE tier, images you send may be used to improve Google's products
# and reviewed by humans (outside the EEA/UK/Switzerland). Student names are personal data.
# If that is a problem, link a billing account to the key's Google Cloud project: the
# paid-tier terms apply (no training on your data) and a scan costs a fraction of a cent.
# GEMINI_API_KEY=

# Models are tried in order; if one is slow, overloaded (503), not available to your key or out
# of free quota, the next one is used. A model that just failed is tried last on the next scan.
# Defaults shown.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Speed. Gemini 3.x "thinks" before answering, which can take 10-30 s; reading text does not need
# it, so "low" (the cheapest level every Flash model accepts) is the default.
#   minimal | low | medium | high | default (= do not send the setting)
# GEMINI_THINKING_LEVEL=low
# Seconds a single Gemini call may take before the next model is tried / for the whole scan:
# GEMINI_REQUEST_TIMEOUT_MS=30000
# GEMINI_TOTAL_BUDGET_MS=75000

# auto (default): Gemini when GEMINI_API_KEY is set, otherwise offline Tesseract
# gemini:         same, but warns if the key is missing
# tesseract:      offline only — nothing leaves this server (weak on handwritten Arabic)
# OCR_PROVIDER=auto

# When Gemini fails (no internet, quota used up) fall back to offline Tesseract.
# Set to false to return an error instead of lower-quality results.
# OCR_FALLBACK_TO_TESSERACT=true

# ── Request limits (optional; the defaults suit a class-sized deployment) ────
# The photo upload (POST /api/ocr) may be big; every other request is small JSON.
# API_BODY_LIMIT=1mb
# OCR_BODY_LIMIT=50mb
# A photo larger than either of these is refused (413) before any OCR engine sees it. A tiny file can
# describe an enormous picture ("decompression bomb"), so the size in PIXELS is limited as well.
# MAX_IMAGE_PIXELS=120000000
# MAX_IMAGE_BYTES=31457280
# Photos one phone may send to the reader per hour (the address limit is 5x this). The free Gemini quota is shared
# by every teacher, so this stops one phone from using it all up. Counted in memory.
# OCR_SCANS_PER_HOUR=200
# New attendance sheets one teacher may create per hour (the address limit is 5x this):
# ATTENDANCE_SHEETS_PER_HOUR=30
# How many reverse proxies stand in front of this server (so the caller's address, used by the limit
# above, is not the proxy's). Render is detected automatically (1); set it for any other proxy/load balancer.
# TRUST_PROXY=1

# ── Cloud hosting (Render, Docker, ...) ──────────────────────────────────────
# Locks every /api route: the app must send this value in the `x-api-key` header
# (Settings → Access key). REQUIRED once the backend is reachable from the internet,
# otherwise anyone who finds the URL can spend your Gemini quota and edit your shared sheets.
# Make one up (20+ random characters). Leave unset for local development.
# APP_API_KEY=

# On a host you cannot upload service-account.json to, paste the whole file as ONE line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com",...}
